# ==============================================================================
# WebGIS MSVT - FastAPI Backend Configuration Template
# ==============================================================================

# Database Connection
# Cách 1: Chuỗi kết nối đầy đủ (Ưu tiên cho Production / Cloud: Neon, Supabase, Railway, Vercel Postgres)
# DATABASE_URL=postgresql://user:password@ep-sample-123.ap-southeast-1.aws.neon.tech/webgis_msvt?sslmode=require

# Cách 2: Kết nối từng tham số (Dùng cho Local development qua Windows host port 5433)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=webgis_msvt
POSTGRES_USER=webgis_admin
POSTGRES_PASSWORD=your_secure_password_here

# When deployed inside Docker Compose network, use:
# POSTGRES_HOST=postgis
# POSTGRES_PORT=5432

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Security & Session Authentication
ENVIRONMENT=development
SECRET_KEY=change_this_to_a_random_32_byte_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Set COOKIE_SECURE=true when deployed with HTTPS; false for HTTP development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
