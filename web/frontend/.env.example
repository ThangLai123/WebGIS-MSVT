# ==============================================================================
# WebGIS MSVT - Frontend Environment Variables Example
# ==============================================================================

# Khi chạy local dev: để trống hoặc không đặt để sử dụng Vite Proxy (/msvt-api -> http://127.0.0.1:8000)
# VITE_MSVT_API_URL=

# Khi triển khai lên Vercel / Production:
# Điền URL thực tế của Backend FastAPI sau khi deploy (ví dụ: https://webgis-msvt-backend.vercel.app)
# Lưu ý: Không có dấu gạch chéo '/' ở cuối URL
VITE_MSVT_API_URL=
